library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.NUMERIC_STD.ALL;

entity counter_seg is
    Port ( clk  : in STD_LOGIC;
           btnC : in STD_LOGIC;
           an   : out STD_LOGIC_VECTOR (3 downto 0);
           seg  : out STD_LOGIC_VECTOR (6 downto 0));
end counter_seg;

architecture Behavioral of counter_seg is
signal clk_div  : integer range 0 to 9999999;
signal clk_slow : STD_LOGIC:= '0';
signal unit : integer range 0 to 9 := 0;
signal tens : integer range 0 to 9:= 0;
signal hun  : integer range 0 to 9 := 0;
signal thou : integer range 0 to 9 := 0;

signal digit_active : integer range 0 to 3:=0 ;
    --signal to track which digit we are currently working on (0 to 3)
signal word_active : STD_LOGIC := '0'; 
    --signal to track if we are in Counting number or Word

function segmt (num : integer) return STD_LOGIC_VECTOR is
begin 
case num is 
    when 0 => return "1000000";
    when 1 => return "1111001";
    when 2 => return "0100100";
    when 3 => return "0110000";
    when 4 => return "0011001";
    when 5 => return "0010010";
    when 6 => return "0000010"; 
    when 7 => return "1111000";
    when 8 => return "0000000";
    when 9 => return "0010000";
    when others => return "1111111";
end case;
end function;

function seg_char (char : integer) return STD_LOGIC_VECTOR is
begin
    case char is
        when 0 => return "0001110"; --F
        when 1 => return "0001100"; --P
        when 2 => return "0000010"; --G
        when 3 => return "0001000"; --A
        when others => return "1111111";
    end case;
end function;

begin
--1
process(clk,btnC)
begin
    if btnC = '1' then
        clk_div  <= 0;
        clk_slow <= '0';
    elsif rising_edge(clk) then
        if clk_div = 9999999 then
            clk_div <= 0;
            clk_slow <= not clk_slow;
        else
            clk_div <= clk_div + 1;
        end if;
    end if;
end process;

--2
process(clk_slow, btnC)
begin
    if btnC = '1' then
        unit <= 0; tens <=0; hun <=0; thou <=0;
        digit_active <= 0;
        word_active <= '0';
    elsif rising_edge(clk_slow) then
        if word_active = '0' then
            if digit_active = 0 then
                if unit = 9 then
                    unit <= 0;
                    digit_active <= 1;
                else
                    unit <= unit + 1;
                end if;
            elsif digit_active = 1 then
                if tens = 9 then
                    tens <= 0;
                    digit_active <= 2;
                else
                    tens <= tens + 1;
                end if;
            elsif digit_active = 2 then
                if hun = 9 then
                    hun <= 0;
                    digit_active <= 3;
                else
                    hun <= hun + 1;
                end if;
            elsif digit_active = 3 then
                if thou = 9 then
                    thou <= 0;
                    word_active <= '1'; 
                else
                    thou <= thou + 1;
                end if;
            end if;
        else
          
            if digit_active = 3 then
                digit_active <= 0;
            else
                digit_active <= digit_active + 1;
            end if;
        end if;
    end if;
end process;


--3
process(digit_active,word_active,unit,tens,hun,thou)
begin
    an<="1111";
    seg<="1111111";
    if word_active = '0' then
        case digit_active is 
            when 0 => an <= "1110"; seg <= segmt(unit);
            when 1 => an <= "1101"; seg <= segmt(tens);
            when 2 => an <= "1011"; seg <= segmt(hun);
            when 3 => an <= "0111"; seg <= segmt(thou);
            when others => an<="1111"; seg<="1111111";
        end case; 
    else
        case digit_active is 
            when 0 => an <= "0111"; seg <= seg_char(0);
            when 1 => an <= "1011"; seg <= seg_char(1);
            when 2 => an <= "1101"; seg <= seg_char(2);
            when 3 => an <= "1110"; seg <= seg_char(3);
            when others => an<="1111"; seg<="1111111";
        end case; 
   end if;
end process;

end Behavioral;
